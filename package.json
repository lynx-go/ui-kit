{
  "name": "@lynx-go/uikit",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "layer-check": "node scripts/layer-check.mjs",
    "size-check": "node scripts/size-check.mjs",
    "check": "pnpm layer-check && pnpm typecheck && pnpm size-check && pnpm test && pnpm test:devtool",
    "demo": "pnpm --filter demo dev",
    "e2e": "pnpm --filter demo e2e",
    "test:devtool": "node --test scripts/devtool.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:default",
    "@lynx-go/uikit-core": "workspace:*",
    "@tanstack/react-form": "catalog:default",
    "@tanstack/react-query": "catalog:default",
    "@tanstack/react-router": "catalog:default",
    "@tanstack/react-table": "catalog:default",
    "@tanstack/table-core": "catalog:default",
    "@types/react": "catalog:default",
    "class-variance-authority": "catalog:default",
    "clsx": "catalog:default",
    "lucide-react": "catalog:default",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "recharts": "catalog:default",
    "rolldown": "catalog:default",
    "tailwind-merge": "catalog:default",
    "typescript": "catalog:default"
  }
}
